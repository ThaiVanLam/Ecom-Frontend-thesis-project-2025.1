# Frontend environment (Vite inlines these at build time).
# Copy to .env for `npm run dev`. For containers these are passed as build args
# by the root docker-compose.yml instead.

# API Gateway base URL.
#   npm run dev            -> http://localhost:8080
#   Docker (nginx proxies) -> leave empty so the SPA calls its own origin
VITE_BACK_END_URL=http://localhost:8080

# Where Stripe sends the browser back after payment.
VITE_FRONTEND_URL=http://localhost:5173

# Stripe publishable key (test mode).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
